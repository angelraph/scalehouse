# --- Network -----------------------------------------------------------------
# mainnet (default) or testnet
NEXT_PUBLIC_NETWORK=mainnet
NEXT_PUBLIC_SCALETICKET_ADDRESS=
# Block the contract was deployed in; the event index starts here.
NEXT_PUBLIC_DEPLOY_BLOCK=
# Optional: a private RPC for the server (falls back to rpc.mainnet.arc.io).
ARC_RPC_URL=
NEXT_PUBLIC_ARC_RPC_URL=

# --- Agent wallet ------------------------------------------------------------
# The address houses appoint with setAgent. Holds only gas money.
NEXT_PUBLIC_AGENT_ADDRESS=
# circle (production: Circle Developer-Controlled Wallet) or local (raw key, testnet)
AGENT_SIGNER=circle
AGENT_ADDRESS=
AGENT_CIRCLE_WALLET_ID=
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
# Only when AGENT_SIGNER=local
AGENT_PRIVATE_KEY=

# --- Claude ------------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Supabase (run supabase/migrations/0001_scalehouse.sql once) --------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional ----------------------------------------------------------------
# Adds OpenSanctions wallet screening on top of Circle's on-chain USDC blocklist.
OPENSANCTIONS_API_KEY=
# Protects /api/cron (Vercel sends it as a Bearer token).
CRON_SECRET=
